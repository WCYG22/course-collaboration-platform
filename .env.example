# GEMINI_API_KEY: Required for Gemini AI API calls (optional - not used currently)
GEMINI_API_KEY="your_api_key_here"

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
# Use 'sqlite' for development or 'postgres' for production
DB_TYPE=sqlite

# PostgreSQL Configuration (if using postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caml_lms
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters

# Email Configuration (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM="CAML LMS <noreply@caml-lms.com>"

# File Upload Configuration
MAX_FILE_SIZE=52428800
# 50MB in bytes

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
